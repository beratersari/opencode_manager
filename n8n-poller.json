        "jsCode": "const j = $input.first().json || {};\nconst body = (j.body && typeof j.body === 'object') ? j.body : {};\nconst err = j.error && typeof j.error === 'object' ? j.error : null;\nconst ack = $('normalizeAck').first().json || {};\nconst http = Number(j.statusCode || j.status || (err && (err.httpCode || err.statusCode)) || 0);\nconst env = (body.status_code != null || body.text || body.job_id || body.live != null) ? body : j;\nlet text = env.text || '';\nif (!text && env.detail != null) text = typeof env.detail === 'string' ? env.detail : JSON.stringify(env.detail);\nif (!text && err) text = err.message || String(err);\nif (!text) text = (typeof j.error === 'string' ? j.error : '') || j.message || '';\nconst jobId = String(env.job_id || ack.job_id || '');\nlet code = Number(env.status_code || 0);\nif (http === 202) code = 202;\nelse if (http === 200 && env.status_code != null) code = Number(env.status_code);\nelse if (http === 404) code = 404;\nelse if (code === 0 && http) code = http;\nif (!jobId && code === 202) code = 400;\nconst terminal = [200, 404, 500, 504].indexOf(code) >= 0 && http !== 202 && env.live !== true;\nconst retry_blip = !terminal && http >= 500 && http < 600;\nconst live = !terminal && jobId.indexOf('job_') === 0 && (env.live === true || code === 202);\nreturn [{ json: {\n  text: text || (live ? '' : (code === 504 ? 'OSM job timed out' : 'OSM poll returned no envelope')),\n  session_id: env.session_id || '',\n  status_code: code || (live ? 202 : 400),\n  jira_id: env.jira_id || ack.jira_id || '',\n  job_id: jobId,\n  live: live,\n  retry_blip: retry_blip,\n  status: env.status || '',\n  http_status: http,\n}}];\n"
