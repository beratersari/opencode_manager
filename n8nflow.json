    {
      "parameters": {
        "jsCode": "let prompt = $input.first().json[\"text\"];\n\nconst anotherWorkFlow = $('When Executed by Another Workflow').first().json;\n\nif ($input.first().json[\"agent\"] === \"planner\") {\n    prompt += \" işi için plan oluştur.\";\n}\n\nprompt += `\\nissue_id: ${anotherWorkFlow.issue_id} \\n`;\n\nprompt += `repo_url: ${anotherWorkFlow.repo_url}`;\n\nif(anotherWorkFlow.session_id === -1){\n  prompt += ` sourceBranch: ${anotherWorkFlow.source_branch_name}`;\n}else{\n  prompt += ` targetBranch: ${anotherWorkFlow.source_branch_name}`;\n}\n\n\n\n\n\nlet issueText = JSON.stringify(prompt);\nreturn [{issueText}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        224
      ],
      "id": "cb31ad63-b3ce-449b-a5e6-d4dfc2b4e086",
      "name": "strginfyInputText1",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const src = $('When Executed by Another Workflow').first().json;\nconst osm = $('remoteComputerInfo1').first().json;\nconst rawIssue = $input.first().json.issueText;\nlet prompt = rawIssue;\nif (typeof rawIssue === 'string') {\n  try { prompt = JSON.parse(rawIssue); } catch { prompt = rawIssue; }\n}\nconst rawSid = src.session_id;\nconst sessionId = (typeof rawSid === 'string' && rawSid.startsWith('ses_')) ? rawSid : '';\nconst mode = String(src.working_mode || 'build').trim().toLowerCase();\nconst agentMap = { plan: 'plan', planner: 'plan', build: 'build', general: 'general', explore: 'explore' };\nconst body = {\n  repo_url: String(src.repo_url || '').trim(),\n  PAT: '',\n  source_branch: String(src.source_branch_name || '').trim(),\n  prompt: prompt,\n  model: 'opencode/mimo-v2.5-free',\n  agent_mode: agentMap[mode] || 'build',\n  timeout_in_seconds: Number(osm.timeout_in_seconds || 1800),\n  retry_count: Number(osm.retry_count || 1),\n  jira_id: String(src.issue_id || '').trim(),\n  callback_url: $execution.resumeUrl,\n};\nif (sessionId) body.session_id = sessionId;\nreturn [{ json: { osmBody: body } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        224
      ],
      "id": "a0b1c2d3-e4f5-4678-8901-23456789abcd",
      "name": "buildOsmRequest",
      "notes": "PAT and model are hardcoded here. Prompt comes from strginfyInputText1. callback_url is $execution.resumeUrl."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://{{ $('remoteComputerInfo1').item.json.osmHost }}:{{ $('remoteComputerInfo1').item.json.osmPort }}/jobs",
