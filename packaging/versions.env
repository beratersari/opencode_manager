# Pinned versions for the offline distribution.
# CI (packaging/build_dist.py) downloads these. Target install is offline.

OPENCODE_VERSION=1.18.10
OPENCODE_WINDOWS_ASSET=opencode-windows-x64.zip
OPENCODE_LINUX_ASSET=opencode-linux-x64.tar.gz
OPENCODE_DARWIN_X64_ASSET=opencode-darwin-x64.zip
OPENCODE_DARWIN_ARM64_ASSET=opencode-darwin-arm64.zip
OPENCODE_REPO=anomalyco/opencode

# Bundled CPython (python-build-standalone). Installers use this to create .venv.
# Do not rely on a system Python on the target.
PYTHON_VERSION=3.12
PYTHON_FULL_VERSION=3.12.14
PYTHON_STANDALONE_TAG=20260825
PYTHON_STANDALONE_REPO=astral-sh/python-build-standalone

# Wheels must match the bundled interpreter only.
PYTHON_WHEEL_VERSIONS=3.12

NODE_VERSION=20

# Windows Service Wrapper. Used only by install-service.bat. Not the two-window exe.
WINSW_VERSION=2.12.0
WINSW_ASSET=WinSW-x64.exe
WINSW_REPO=winsw/winsw
