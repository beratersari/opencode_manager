# Pinned versions for the offline distribution.
# CI (packaging/build_dist.py) downloads these. Target install is offline.

OPENCODE_VERSION=1.18.10
OPENCODE_WINDOWS_ASSET=opencode-windows-x64.zip
OPENCODE_LINUX_ASSET=opencode-linux-x64.tar.gz
OPENCODE_DARWIN_X64_ASSET=opencode-darwin-x64.zip
OPENCODE_DARWIN_ARM64_ASSET=opencode-darwin-arm64.zip
OPENCODE_REPO=anomalyco/opencode

# Host Python used in CI to run pip download (any 3.11+ is fine)
PYTHON_VERSION=3.12

# Offline wheels are fetched for each of these CPython minor versions.
# install.sh / install.bat only accept versions listed in vendor/SUPPORTED_PYTHON.txt.
PYTHON_MIN_VERSION=3.11
PYTHON_WHEEL_VERSIONS=3.11,3.12,3.13

NODE_VERSION=20
